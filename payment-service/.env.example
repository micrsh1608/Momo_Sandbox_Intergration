# Payment Service
PAYMENT_PROVIDER_MODE=mock

# SQL Server
DB_SERVER=HUY-PC
DB_NAME=PaymentDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Internal API security
INTERNAL_TOKEN=secret_internal_token_123

# MoMo Sandbox - replace with your real credentials when PAYMENT_PROVIDER_MODE=momo
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://example.com/payment/callback
MOMO_IPN_URL=https://YOUR_PUBLIC_HOST/internal/payments/ipn
MOMO_REQUEST_TIMEOUT=30

# Local IPN demo keys used only when PAYMENT_PROVIDER_MODE=mock
IPN_DEMO_ACCESS_KEY=demo_access_key
IPN_DEMO_SECRET_KEY=demo_secret_key
