APP_NAME=MoMo Payment Service

DB_SERVER=HUY-PC
DB_NAME=PaymentDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

INTERNAL_TOKEN=secret_internal_token_123
PAYMENT_PROVIDER_MODE=mock

# MoMo Sandbox credentials: fill these from your MoMo test account.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Must be publicly reachable over HTTPS for real Sandbox IPN delivery.
MOMO_REDIRECT_URL=https://your-public-host.example/payment/callback
MOMO_IPN_URL=https://your-public-host.example/api/v1/payments/ipn
MOMO_REQUEST_TIMEOUT=30.0
