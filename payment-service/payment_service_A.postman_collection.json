    {
      "name": "B1. Nhận IPN Success (HMAC)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internal/payments/ipn",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "internal",
            "payments",
            "ipn"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"MOMO\",\n  \"orderId\": \"{{demo_payment_id}}\",\n  \"requestId\": \"{{demo_provider_request_id}}\",\n  \"amount\": 50000,\n  \"orderInfo\": \"Demo Member B\",\n  \"orderType\": \"momo_wallet\",\n  \"transId\": \"{{demo_trans_id}}\",\n  \"resultCode\": 0,\n  \"message\": \"Success\",\n  \"payType\": \"qr\",\n  \"responseTime\": \"{{demo_response_time}}\",\n  \"extraData\": \"\",\n  \"signature\": \"{{momo_ipn_signature}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const accessKey = pm.collectionVariables.get('momo_access_key');",
              "const secretKey = pm.collectionVariables.get('momo_secret_key');",
              "const amount = '50000';",
              "const extraData = '';",
              "const message = 'Success';",
              "const orderId = pm.collectionVariables.get('demo_payment_id');",
              "const orderInfo = 'Demo Member B';",
              "const orderType = 'momo_wallet';",
              "const partnerCode = 'MOMO';",
              "const payType = 'qr';",
              "const requestId = pm.collectionVariables.get('demo_provider_request_id');",
              "const responseTime = Date.now().toString();",
              "const resultCode = '0';",
              "const transId = pm.collectionVariables.get('demo_trans_id');",
              "pm.collectionVariables.set('demo_response_time', responseTime);",
              "const raw = `accessKey=${accessKey}&amount=${amount}&extraData=${extraData}&message=${message}&orderId=${orderId}&orderInfo=${orderInfo}&orderType=${orderType}&partnerCode=${partnerCode}&payType=${payType}&requestId=${requestId}&responseTime=${responseTime}&resultCode=${resultCode}&transId=${transId}`;",
              "const signature = CryptoJS.HmacSHA256(raw, secretKey).toString(CryptoJS.enc.Hex);",
              "pm.collectionVariables.set('momo_ipn_signature', signature);"
            ]
          }
        }
      ]
    },
